<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "CEGA")</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="app d-flex flex-column min-vh-100">
    <!-- TOP NAVBAR (siempre visible) -->
    <header>
        <nav class="navbar navbar-expand-md navbar-light navbar-cega sticky-top-cega mb-0">
            <div class="container-fluid">
                <!-- Marca -->
                <a class="navbar-brand d-flex align-items-center gap-2"
                   asp-controller="Home" asp-action="Index">
                    <span class="brand-logo-circle">C</span>
                    <span class="brand-wordmark">CEGA</span>
                </a>

                <!-- Botón menú móvil -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#topNav" aria-controls="topNav" aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="topNav" class="collapse navbar-collapse">
                    @* Menú izquierdo: solo cuando hay sesión *@
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Gráficos</a>
                            </li>
                        </ul>
                    }

                    @* Menú derecho *@
                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item me-2">
                                <div class="dash-user-pill">
                                    <span class="dash-user-avatar">
                                        @User.Identity!.Name?.FirstOrDefault()
                                    </span>
                                    <span class="dash-user-name">
                                        @User.Identity!.Name
                                    </span>
                                </div>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button class="btn btn-logout btn-sm" type="submit">
                                        Cerrar sesión
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Contenido principal -->
    <main class="flex-fill">
        @if (User?.Identity?.IsAuthenticated == true)
        {
            <!-- SHELL con SIDEBAR + CONTENIDO -->
            <div class="app-shell">
                <aside id="sidebar-cega" class="sidebar-cega">
                    <div class="sidebar-inner">
                        <!-- cabecera del sidebar -->
                        <div class="sidebar-head d-flex align-items-center justify-content-between px-3 mb-2">
                            <span class="sidebar-title d-none d-md-inline">Panel</span>

                            <button class="btn btn-sm btn-outline-secondary d-md-none"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#sidebarNav"
                                    aria-controls="sidebarNav"
                                    aria-expanded="true"
                                    aria-label="Menú">
                                ☰
                            </button>
                        </div>

                        <nav id="sidebarNav" class="sidebar-nav collapse show d-md-block">
                            <a class="sidebar-item nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Usuarios" ? "active" : "")"
                               asp-controller="Usuarios" asp-action="Index">
                                <span class="sidebar-dot"></span>
                                <span>Gestión de Usuarios</span>
                            </a>

                            <a class="sidebar-item nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Empleados" ? "active" : "")"
                               asp-controller="Empleados" asp-action="Index">
                                <span class="sidebar-dot"></span>
                                <span>Empleados</span>
                            </a>

                            <a class="sidebar-item nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Marketing" ? "active" : "")"
                               asp-controller="Marketing" asp-action="Index">
                                <span class="sidebar-dot"></span>
                                <span>Marketing</span>
                            </a>

                            <a class="sidebar-item nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contabilidad" ? "active" : "")"
                               asp-controller="Contabilidad" asp-action="Index">
                                <span class="sidebar-dot"></span>
                                <span>Contabilidad</span>
                            </a>

                            <a class="sidebar-item nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reporteria" ? "active" : "")"
                               asp-controller="Reporteria" asp-action="Index">
                                <span class="sidebar-dot"></span>
                                <span>Reportería</span>
                            </a>

                            <a class="sidebar-item nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Seguimiento" ? "active" : "")"
                               asp-controller="Seguimiento" asp-action="Index">
                                <span class="sidebar-dot"></span>
                                <span>Seguimiento</span>
                            </a>

                            <a class="sidebar-item nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Pdf" ? "active" : "")"
                               asp-controller="Pdf" asp-action="Index">
                                <span class="sidebar-dot"></span>
                                <span>Módulo PDF</span>
                            </a>
                        </nav>
                    </div>
                </aside>

                <div class="content-cega">
                    <div role="main" class="pb-4">
                        @RenderBody()
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="container">
                <div role="main" class="pb-4">
                    @RenderBody()
                </div>
            </div>
        }
    </main>

    <!-- Footer pegado al fondo -->
    <footer id="site-footer" class="footer-cega mt-auto">
        <div class="container d-flex justify-content-between align-items-center">
            <span class="text-muted small">© 2025 · CEGA</span>
            <span class="text-muted small">Dashboard interno</span>
        </div>
    </footer>

    @RenderSection("Modals", required: false)

    <div class="modal fade" id="modalDynamic" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body"><div class="p-3 text-center">Cargando…</div></div>
            </div>
        </div>
    </div>

    <!-- Scripts base -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
