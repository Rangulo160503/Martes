@model CEGA.Models.ViewModels.Usuarios.BuscarUsuarioFiltroViewModel

@{
    ViewData["Title"] = "Gestión de Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-card">
    <!-- Encabezado de la sección -->
    <div class="page-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1">Gestión de Usuarios</h1>
            <p class="text-muted small mb-0">
                Administra los <strong>roles</strong> y el <strong>estado activo</strong> de los colaboradores.
            </p>
        </div>

        @if (Model?.UsuariosFiltrados != null)
        {
            <span class="badge bg-light text-secondary">
                @Model.UsuariosFiltrados.Count() usuario(s)
            </span>
        }
    </div>

    <div class="page-card-body">
        <!-- Filtros -->
        <form method="get" class="row g-3 mb-4">
            <div class="col-md-4">
                <input type="text"
                       name="query"
                       value="@Model.Query"
                       class="form-control shadow-sm"
                       placeholder="Buscar por nombre, usuario o correo..." />
            </div>

            <div class="col-md-3">
                <select name="rol" class="form-select shadow-sm">
                    <option value="">-- Todos los roles --</option>
                    @foreach (var r in Model.RolesDisponibles)
                    {
                        <option value="@r" selected="@(Model.Rol == r)">
                            @r
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 shadow-sm">
                    Buscar
                </button>
            </div>
        </form>

        <!-- Tabla de usuarios -->
        @if (Model.UsuariosFiltrados.Any())
        {
            <div class="table-responsive shadow-sm rounded-3">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nombre completo</th>
                            <th>Usuario</th>
                            <th>Email</th>
                            <th>Teléfono</th>
                            <th>Rol</th>
                            <th>Activo</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.UsuariosFiltrados)
                        {
                            <tr>
                                <td class="fw-semibold">@u.NombreCompleto</td>
                                <td>@u.Username</td>
                                <td>@u.Email</td>
                                <td>@u.TelefonoPersonal</td>

                                <!-- Rol editable -->
                                <td>
                                    <select class="form-select border-0 shadow-sm">
                                        @foreach (var r in Model.RolesDisponibles)
                                        {
                                            <option value="@r" selected="@(u.Rol == r)">
                                                @r
                                            </option>
                                        }
                                    </select>
                                </td>

                                <!-- Activo: ahora editable Sí / No -->
                                <td>
                                    <select class="form-select form-select-sm w-auto">
                                        <option value="true" selected="@(u.Activo)">Sí</option>
                                        <option value="false" selected="@(!u.Activo)">No</option>
                                    </select>
                                </td>

                                <!-- Acciones: solo Guardar (sin Eliminar) -->
                                <td>
                                    <button class="btn btn-sm btn-success shadow-sm">
                                        Guardar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info shadow-sm rounded-3 mt-3">
                No se encontraron usuarios con los filtros aplicados.
            </div>
        }
    </div>
</div>

@* 
   El modal de confirmación de eliminación y el script asociado
   ya no son necesarios, así que se eliminan por completo.
*@
