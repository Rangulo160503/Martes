@model CEGA.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Quiénes Somos";
    if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
    {
        Layout = null;
    }
}

<!-- HERO LOGIN ESTILO DASHER -->
<section class="login-hero d-flex align-items-center min-vh-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-xl-5">

                <!-- Logo + textos arriba del card -->
                <div class="text-center mb-4">
                    <div class="login-logo rounded-circle d-inline-flex align-items-center justify-content-center mb-3">
                        <span class="fw-bold fs-4">C</span>
                    </div>
                    <h1 class="fw-bold mb-1">Bienvenido de nuevo</h1>
                    <p class="text-muted mb-0">
                        ¿Aún no tienes cuenta?
                        <button type="button"
                                class="btn btn-link p-0 align-baseline text-success fw-semibold"
                                onclick="openModal('@Url.Action("Register", "Account")','Crear cuenta')">
                            Regístrate aquí
                        </button>
                    </p>
                </div>

                <!-- Card de login -->
                <div class="card login-card border-0 shadow-lg">
                    <div class="card-body p-4 p-sm-5">
                        <form asp-action="Login" method="post" class="vstack gap-3">
                            <div asp-validation-summary="All" class="text-danger mb-2"></div>
                            @Html.AntiForgeryToken()

                            <div>
                                <label asp-for="UserOrEmail" class="form-label fw-semibold">Correo</label>
                                <input asp-for="UserOrEmail"
                                       class="form-control form-control-lg"
                                       autocomplete="username"
                                       placeholder="tucorreo@ejemplo.com" />
                                <span asp-validation-for="UserOrEmail" class="text-danger"></span>
                            </div>

                            <div>
                                <label asp-for="Password" class="form-label fw-semibold">Contraseña</label>
                                <input asp-for="Password"
                                       type="password"
                                       class="form-control form-control-lg"
                                       autocomplete="current-password"
                                       placeholder="••••••••" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="rememberMe">
                                    <label class="form-check-label" for="rememberMe">
                                        Recordarme
                                    </label>
                                </div>
                                <button type="button"
                                        class="btn btn-link p-0 text-success fw-semibold"
                                        onclick="openModal('@Url.Action("RecuperarAcceso", "Account")','Recuperar acceso')">
                                    ¿Olvidó su contraseña?
                                </button>
                            </div>

                            <button type="submit" class="btn btn-success btn-lg w-100 mt-1">
                                Iniciar sesión
                            </button>

                            @* Si quieres, puedes dejar este bloque para “social login” más adelante *@
                            <div class="text-center mt-4">
                                <span class="text-muted small">Inicia sesión con tu red social</span>
                                <div class="d-flex gap-2 mt-3">
                                    <button type="button" class="btn btn-outline-secondary w-50">
                                        <i class="bi bi-google me-1"></i> Google
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary w-50">
                                        <i class="bi bi-facebook me-1"></i> Facebook
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>
