@model IEnumerable<CEGA.Models.Incapacidad>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    // Dropdown de empleados que viene desde el Index via ViewData
    var empleados = ViewData["Empleados"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();

    // Agrupar incapacidades por empleado (cédula)
    var grupos = (Model ?? Enumerable.Empty<CEGA.Models.Incapacidad>())
        .GroupBy(i => new
        {
            i.Cedula,
            Nombre = i.Empleado != null
                ? $"{i.Empleado.Nombre} {i.Empleado.Apellido1} {i.Empleado.Apellido2}".Trim()
                : "",
            Correo = i.Empleado?.Email
        })
        .OrderBy(g => g.Key.Nombre);
}

<!-- ============ SUBIR INCAPACIDAD ============ -->
<div class="card mb-3">
    <div class="card-header">Subir incapacidad</div>
    <div class="card-body">
        <form asp-controller="Empleados"
              asp-action="SubirIncapacidad"
              method="post"
              enctype="multipart/form-data"
              class="row g-3">
            @Html.AntiForgeryToken()

            <div class="col-md-4">
                <label class="form-label" for="cedulaInc">Empleado</label>
                <select id="cedulaInc" name="cedula" class="form-select" required asp-items="empleados">
                    <option value="">— Seleccione —</option>
                </select>
            </div>

            <div class="col-md-5">
                <label class="form-label" for="archivoInc">Archivo</label>
                <input id="archivoInc" name="archivo" type="file" class="form-control" required />
                <small class="text-muted d-block">
                    PDF o imagen/documento escaneado.
                </small>
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-success">
                    Guardar
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ============ LISTADO AGRUPADO POR EMPLEADO ============ -->
<div class="card">
    <div class="card-header">Incapacidades cargadas</div>
    <div class="card-body p-0">
        @if (grupos.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width: 110px;">Cédula</th>
                            <th>Empleado</th>
                            <th>Correo</th>
                            <th style="width: 130px;" class="text-center">Incapacidades</th>
                            <th style="width: 260px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in grupos)
                        {
                            var key = g.Key;
                            var cantidad = g.Count();

                            <tr>
                                <td>@key.Cedula</td>
                                <td>@key.Nombre</td>
                                <td>@key.Correo</td>

                                <!-- Contador por empleado -->
                                <td class="text-center">
                                    <span class="badge bg-success-subtle text-success fw-semibold">
                                        @cantidad
                                    </span>
                                </td>

                                <td>
                                    <div class="d-flex flex-wrap gap-2">
                                        <!-- Descargar: sigue usando la cédula como hasta ahora -->
                                        <a asp-controller="Empleados"
                                           asp-action="DescargarIncapacidad"
                                           asp-route-cedula="@key.Cedula"
                                           class="btn btn-sm btn-outline-primary">
                                            Descargar
                                        </a>

                                        <!-- Reemplazar: igual que antes, pero sin eliminar -->
                                        <form asp-controller="Empleados"
                                              asp-action="ActualizarIncapacidad"
                                              method="post"
                                              enctype="multipart/form-data"
                                              class="d-inline-flex align-items-center gap-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="cedula" value="@key.Cedula" />
                                            <input type="file" name="archivo" class="form-control form-control-sm" required />
                                            <button type="submit" class="btn btn-sm btn-secondary">
                                                Reemplazar
                                            </button>
                                        </form>

                                        @* Botón Eliminar eliminado a propósito *@
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-3 text-muted">
                No hay incapacidades cargadas.
            </div>
        }
    </div>
</div>
