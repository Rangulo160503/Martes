@model IEnumerable<CEGA.Models.VacacionesEmpleado>

@using CEGA.Models
@using CEGA.Models.ViewModels.Empleados
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Text.Json

@{
    // Dropdown de empleados (texto: "cedula — nombre")
    var empleadosSelect = ViewData["Empleados"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();

    // Si algún día llenas el resumen desde el controller, se muestra arriba
    var resumen = ViewBag.ResumenVacaciones as IEnumerable<VacacionesResumenVM> ?? Enumerable.Empty<VacacionesResumenVM>();

    // Lista de entidades Empleado que viene desde el controller
    var empleadosEntidad = ViewBag.EmpleadosEntidad as IEnumerable<Empleado> ?? Enumerable.Empty<Empleado>();

    var hoy = DateTime.Today;

    // Vacaciones existentes agrupadas por cédula
    var vacPorCedula = (Model ?? Enumerable.Empty<VacacionesEmpleado>())
        .GroupBy(v => v.Cedula)
        .ToDictionary(g => g.Key, g => g.ToList());

    // Información por empleado: días ganados, tomados, disponibles, etc.
    var infoPorEmpleado = empleadosEntidad.ToDictionary(
        e => e.Cedula,
        e =>
        {
            var ingreso = e.FechaIngreso == default ? hoy : e.FechaIngreso.Date;

            // Meses completos trabajados desde la fecha de ingreso
            var meses = (hoy.Year - ingreso.Year) * 12 + (hoy.Month - ingreso.Month);
            if (hoy.Day < ingreso.Day)
                meses = Math.Max(0, meses - 1);

            var diasGanados = meses; // 1 día por mes

            // Vacaciones de este empleado (puede no tener ninguna)
            if (!vacPorCedula.TryGetValue(e.Cedula, out var listaVac))
            {
                listaVac = new List<VacacionesEmpleado>();
            }

            listaVac = listaVac
                .OrderBy(x => x.Fecha)
                .ThenBy(x => x.Id)
                .ToList();

            // Detalle por día: índice y fecha en que se ganó
            var listaDet = listaVac
                .Select((vac, idx) => new
                {
                    Vac = vac,
                    Index = idx + 1,
                    FechaGanada = ingreso.AddMonths(idx + 1)
                })
                .ToList();

            var diasTomadosActivos = listaVac.Count(v => v.Activa);
            var diasDisponibles = Math.Max(0, diasGanados - diasTomadosActivos);

            return new
            {
                Empleado = e,
                Ingreso = ingreso,
                Ganados = diasGanados,
                Tomados = diasTomadosActivos,
                Disponibles = diasDisponibles,
                Lista = listaDet
            };
        });

    // Mapa simple para el script del formulario (clave: "cedula" como string)
    var disponiblesMap = infoPorEmpleado.ToDictionary(
        kvp => kvp.Key.ToString(),
        kvp => kvp.Value.Disponibles);
}

@if (resumen?.Any() == true)
{
    <div class="card mb-3">
        <div class="card-header">Resumen por empleado (ciclo vigente)</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Cédula</th>
                            <th>Empleado</th>
                            <th>Ingreso</th>
                            <th>Ciclo</th>
                            <th class="text-end">Acumulados</th>
                            <th class="text-end">Tomados</th>
                            <th class="text-end">Disponibles</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in resumen.OrderBy(x => x.NombreCompleto))
                        {
                            <tr>
                                <td>@r.Cedula</td>
                                <td>@r.NombreCompleto</td>
                                <td>@r.FechaIngreso:yyyy-MM-dd</td>
                                <td>@r.CicloInicio:yyyy-MM-dd — @r.CicloFin:yyyy-MM-dd</td>
                                <td class="text-end">@r.DiasAcumuladosAlDia / @r.DiasAnuales</td>
                                <td class="text-end">@r.DiasTomadosEnCiclo</td>
                                <td class="text-end">@r.DiasDisponibles</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- ============ ALTA (crear día de vacaciones) ============ -->
<div class="card mb-3">
    <div class="card-header">Registrar día de vacaciones</div>
    <div class="card-body">
        <form asp-controller="Empleados"
              asp-action="CrearVacacion"
              method="post"
              class="row g-3">
            @Html.AntiForgeryToken()

            <div class="col-md-6">
                <label class="form-label" for="Cedula">Empleado</label>
                <select id="Cedula"
                        name="Cedula"
                        class="form-select"
                        required
                        asp-items="empleadosSelect">
                    <option value="">— Seleccione —</option>
                </select>

                <div class="form-text">
                    Días disponibles:
                    <span id="lblDiasDisponibles">0</span>
                </div>
                <div id="msgSinDias" class="form-text text-danger d-none">
                    Este colaborador no tiene días disponibles para solicitar.
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label" for="Fecha">Fecha a tomar</label>
                <input id="Fecha"
                       name="Fecha"
                       type="date"
                       class="form-control"
                       value="@DateTime.Today.ToString("yyyy-MM-dd")"
                       required />
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <button type="submit"
                        class="btn btn-success"
                        id="btnGuardarVac">
                    Guardar
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ============ LISTADO AGRUPADO POR EMPLEADO ============ -->
<div class="card">
    <div class="card-header">Solicitudes registradas</div>
    <div class="card-body p-0">
        @if (vacPorCedula.Any())
        {
            var gruposTabla = vacPorCedula
            .Select(kvp => new
            {
                Cedula = kvp.Key,
                Vacaciones = kvp.Value
            .OrderByDescending(v => v.Fecha)
            .ThenByDescending(v => v.Id)
            .ToList(),
                Info = infoPorEmpleado.ContainsKey(kvp.Key)
            ? infoPorEmpleado[kvp.Key]
            : null
            })
            .OrderBy(g => g.Info?.Empleado?.Apellido1 ?? "")
            .ThenBy(g => g.Info?.Empleado?.Apellido2 ?? "")
            .ThenBy(g => g.Info?.Empleado?.Nombre ?? "");

            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width: 110px;">Cédula</th>
                            <th>Empleado</th>
                            <th style="width: 130px;" class="text-center">Disponibles</th>
                            <th style="width: 160px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in gruposTabla)
                        {
                            var emp = g.Info?.Empleado;
                            var nombre = emp != null
                            ? $"{emp.Nombre} {emp.Apellido1} {emp.Apellido2}".Trim()
                            : "(desconocido)";

                            var disponibles = g.Info?.Disponibles ?? 0;
                            var modalId = $"vacDetalle-{g.Cedula}";

                            <tr>
                                <td>@g.Cedula</td>
                                <td>@nombre</td>

                                <td class="text-center">
                                    <span class="badge bg-success-subtle text-success fw-semibold">
                                        @disponibles
                                    </span>
                                </td>

                                <td>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            data-bs-toggle="modal"
                                            data-bs-target="#@modalId">
                                        Detalles
                                    </button>

                                    <!-- Modal por empleado -->
                                    <div class="modal fade"
                                         id="@modalId"
                                         tabindex="-1"
                                         aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Detalles de vacaciones</h5>
                                                    <button type="button"
                                                            class="btn-close"
                                                            data-bs-dismiss="modal"
                                                            aria-label="Cerrar"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="mb-1">
                                                        <strong>Empleado:</strong> @nombre (@g.Cedula)
                                                    </p>

                                                    @if (g.Info != null)
                                                    {
                                                        <p class="mb-1">
                                                            <strong>Fecha ingreso:</strong>
                                                            @g.Info.Ingreso.ToString("dd/MM/yyyy")
                                                        </p>
                                                        <p class="mb-1">
                                                            <strong>Días ganados:</strong> @g.Info.Ganados
                                                        </p>
                                                        <p class="mb-1">
                                                            <strong>Días tomados:</strong> @g.Info.Tomados
                                                        </p>
                                                        <p class="mb-3">
                                                            <strong>Días disponibles:</strong> @g.Info.Disponibles
                                                        </p>

                                                        <hr />
                                                        <h6 class="fw-semibold">Vacaciones tomadas</h6>

                                                        @if (g.Info.Lista != null && g.Info.Lista.Count > 0)
                                                        {
                                                            <ul class="list-group list-group-flush small">
                                                                @foreach (var item in g.Info.Lista)
                                                                {
                                                                    <li class="list-group-item px-0">
                                                                        <div class="d-flex justify-content-between">
                                                                            <span>
                                                                                Día #@item.Index –
                                                                                tomada el @item.Vac.Fecha.ToString("dd/MM/yyyy")
                                                                            </span>
                                                                            <span class="text-muted">
                                                                                ganada el @item.FechaGanada.ToString("dd/MM/yyyy")
                                                                            </span>
                                                                        </div>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        }
                                                        else
                                                        {
                                                            <p class="text-muted mb-0">
                                                                Este colaborador aún no ha tomado vacaciones.
                                                            </p>
                                                        }
                                                    }
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button"
                                                            class="btn btn-secondary"
                                                            data-bs-dismiss="modal">
                                                        Cerrar
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-3 text-muted">No hay solicitudes registradas.</div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const disponiblesPorEmpleado = @Html.Raw(JsonSerializer.Serialize(disponiblesMap));

            const ddl = document.getElementById("Cedula");
            const lbl = document.getElementById("lblDiasDisponibles");
            const msg = document.getElementById("msgSinDias");
            const btn = document.getElementById("btnGuardarVac");

            if (!ddl || !lbl || !msg || !btn) return;

            function actualizarDisponibles() {
                const ced = ddl.value;
                const disp = ced && disponiblesPorEmpleado[ced] !== undefined
                    ? disponiblesPorEmpleado[ced]
                    : 0;

                lbl.textContent = disp;

                if (disp <= 0) {
                    msg.classList.remove("d-none");
                    btn.disabled = true;
                } else {
                    msg.classList.add("d-none");
                    btn.disabled = false;
                }
            }

            ddl.addEventListener("change", actualizarDisponibles);
            actualizarDisponibles(); // inicial
        })();
    </script>
}
